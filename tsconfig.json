{
  // The shared packages and their tests, checked on their own. Each program checks
  // them again with its own platform's types (the phone's leaves out the DOM).
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vitest/globals"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    // No `baseUrl` (TypeScript 6 refuses it): paths resolve from this file. Every program
    // maps the same names (its tsconfig, bundler and test runner).
    "paths": {
      "@unlease/core/*": ["./packages/core/src/*"],
      "@unlease/design/*": ["./packages/design/src/*"],
      "@unlease/notes/*": ["./packages/notes/src/*"]
    }
  },
  "include": ["packages/*/src", "vitest.config.ts", "vitest.setup.ts"]
}
