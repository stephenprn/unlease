<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Sync and link reading need the owner's server, so the release build keeps INTERNET. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To hear the network come back, so sync resumes at once. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- RECEIVE_BOOT_COMPLETED lets Notifee re-arm triggers after a restart, and the reminders'
         refresh run (RefreshReceiver). A reminder and a kitchen timer ring on the minute: exact alarms.
         From Android 13, USE_EXACT_ALARM, granted at install and never taken back (since Android 14
         SCHEDULE_EXACT_ALARM is refused by default, and an inexact alarm may come up to an hour late);
         Android 12 asks for SCHEDULE_EXACT_ALARM. Sideloaded, never on Play, so the store's exact-alarm
         policy does not apply. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" tools:node="replace" />
    <!-- Réglages' « Notifications à l'heure » asks Android to leave the app out of the battery's
         optimization only when the person chooses to (RemindersModule). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Declared by Notifee for features this app never uses. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" tools:node="remove" />

    <!-- The suite's link between its apps on one phone (mobile/shared, SuiteLink): only an app signed
         by the same key holds this permission, so only the suite's own apps read each other's
         connection (the token is a secret). Every app of the suite declares it the same way. -->
    <permission
        android:name="com.stephenprn.unlease.permission.SUITE"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.stephenprn.unlease.permission.SUITE" />

    <!-- Picker and camera are reached by intent: no storage or camera permission is held. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <!-- The suite's apps, seen from this one: their providers (SuiteLink) and their links
             (unlease-pages://page/<id>). and Agenda's
             (unlease-agenda://event/<id>). -->
        <package android:name="com.stephenprn.carnet" />
        <package android:name="com.stephenprn.pages" />
        <package android:name="com.stephenprn.contacts" />
        <package android:name="com.stephenprn.agenda" />
    </queries>

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:fullBackupContent="@xml/backup_rules"
      android:dataExtractionRules="@xml/data_extraction_rules"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|locale|layoutDirection"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <!-- Opened from the launcher through its entries below (one per palette's icon), never directly:
             every other way in stays here. -->

        <!-- The share sheet: links and text, one image or several (src/app/intake.ts); a share through a
             collection's sharing shortcut (res/xml/shortcuts.xml) names it (EXTRA_SHORTCUT_ID). -->
        <intent-filter android:label="@string/share_links">
            <action android:name="android.intent.action.SEND" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="text/plain" />
        </intent-filter>
        <intent-filter android:label="@string/share_images">
            <action android:name="android.intent.action.SEND" />
            <action android:name="android.intent.action.SEND_MULTIPLE" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="image/*" />
        </intent-filter>

        <!-- Text selected in another app (its menu's « Noter dans Carnet »): a link is filed, words become a
             note, as a share is. Nothing is handed back, so a read-only selection is the same. -->
        <intent-filter android:label="@string/process_text">
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="text/plain" />
        </intent-filter>

        <!-- carnet://note/<id>, line/<id>, link/<id>, label/<id>, capture/<kind>: custom scheme, no host. -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="carnet" />
        </intent-filter>
      </activity>

      <!-- The launcher's entries: the app's icon in each palette's primary (tools/icons/build_android_drawables.mjs),
           the one for the person's primary turned on when the app leaves the screen
           (mobile/shared/src/app/launcherIcon.ts). -->
      <!-- GENERATED by tools/icons/build_android_drawables.mjs, do not edit: the launcher entries -->
      <activity-alias
        android:name=".LauncherCarnet"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enabled="true"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.stephenprn.unlease.launcher.palette" android:value="carnet" />
        <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
      </activity-alias>
      <activity-alias
        android:name=".LauncherSarcelle"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_sarcelle"
        android:roundIcon="@mipmap/ic_launcher_sarcelle"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.stephenprn.unlease.launcher.palette" android:value="sarcelle" />
        <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
      </activity-alias>
      <activity-alias
        android:name=".LauncherMyrtille"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_myrtille"
        android:roundIcon="@mipmap/ic_launcher_myrtille"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.stephenprn.unlease.launcher.palette" android:value="myrtille" />
        <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
      </activity-alias>
      <activity-alias
        android:name=".LauncherGlycine"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_glycine"
        android:roundIcon="@mipmap/ic_launcher_glycine"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.stephenprn.unlease.launcher.palette" android:value="glycine" />
        <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
      </activity-alias>
      <activity-alias
        android:name=".LauncherPivoine"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_pivoine"
        android:roundIcon="@mipmap/ic_launcher_pivoine"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.stephenprn.unlease.launcher.palette" android:value="pivoine" />
        <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
      </activity-alias>
      <activity-alias
        android:name=".LauncherMimosa"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_mimosa"
        android:roundIcon="@mipmap/ic_launcher_mimosa"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.stephenprn.unlease.launcher.palette" android:value="mimosa" />
        <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
      </activity-alias>
      <activity-alias
        android:name=".LauncherArdoise"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_ardoise"
        android:roundIcon="@mipmap/ic_launcher_ardoise"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.stephenprn.unlease.launcher.palette" android:value="ardoise" />
        <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
      </activity-alias>
      <activity-alias
        android:name=".LauncherMousse"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_mousse"
        android:roundIcon="@mipmap/ic_launcher_mousse"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.stephenprn.unlease.launcher.palette" android:value="mousse" />
        <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
      </activity-alias>
      <!-- GENERATED: end of the launcher entries -->

      <!-- Where the launcher's static shortcuts land (res/xml/shortcuts.xml): it hands their link to
           MainActivity, so Android's clearing of the task a static shortcut opens touches only its own.
           Never shows. -->
      <activity
        android:name="com.stephenprn.unlease.launch.ShortcutActivity"
        android:theme="@android:style/Theme.NoDisplay"
        android:exported="false"
        android:taskAffinity=""
        android:excludeFromRecents="true"
        android:noHistory="true" />

      <!-- The Quick Settings tile « Nouvelle note »: an action, never on or off; only the system binds it. -->
      <service
        android:name=".tile.NewNoteTileService"
        android:exported="true"
        android:label="@string/tile_new_note"
        android:icon="@drawable/ic_tile_note"
        android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
        <intent-filter>
          <action android:name="android.service.quicksettings.action.QS_TILE" />
        </intent-filter>
      </service>

      <!-- The home-screen widgets (android/.../widget, docs/ARCHITECTURE.md). The providers are exported
           because the launcher broadcasts APPWIDGET_UPDATE to them; they take no data from it. -->

      <receiver
        android:name=".widget.CaptureWidgetProvider"
        android:exported="true"
        android:label="@string/widget_capture_label">
        <intent-filter>
          <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent-filter>
        <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/widget_capture_info" />
      </receiver>

      <receiver
        android:name=".widget.LinkWidgetProvider"
        android:exported="true"
        android:label="@string/widget_link_label">
        <intent-filter>
          <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent-filter>
        <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/widget_link_info" />
      </receiver>

      <receiver
        android:name=".widget.CollectionWidgetProvider"
        android:exported="true"
        android:label="@string/widget_collection_label">
        <intent-filter>
          <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent-filter>
        <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/widget_collection_info" />
      </receiver>

      <receiver
        android:name=".widget.LabelWidgetProvider"
        android:exported="true"
        android:label="@string/widget_label_label">
        <intent-filter>
          <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent-filter>
        <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/widget_label_info" />
      </receiver>

      <receiver
        android:name=".widget.NoteWidgetProvider"
        android:exported="true"
        android:label="@string/widget_note_label">
        <intent-filter>
          <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent-filter>
        <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/widget_note_info" />
      </receiver>

      <!-- A tick on a note widget: only our own PendingIntents reach it. -->
      <receiver android:name=".widget.WidgetTickReceiver" android:exported="false" />

      <!-- The quick window over the home screen: the link field and the pickers. Exported for the
           launcher's configuration step; its own task, gone once left, never in Recents. -->
      <activity
        android:name=".widget.QuickActivity"
        android:theme="@style/QuickTheme"
        android:exported="true"
        android:label="@string/app_name"
        android:taskAffinity="${applicationId}.quick"
        android:excludeFromRecents="true"
        android:noHistory="true"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|locale|layoutDirection"
        android:windowSoftInputMode="adjustResize">
        <intent-filter>
          <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
        </intent-filter>
      </activity>

      <!-- Sends a widget list's tap on to the app or a website; it never shows. -->
      <activity
        android:name=".widget.WidgetRouterActivity"
        android:theme="@android:style/Theme.NoDisplay"
        android:exported="false"
        android:taskAffinity=""
        android:excludeFromRecents="true"
        android:noHistory="true" />

      <!-- Lets the system camera app write one photo into files/photos; not exported. -->
      <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.files"
        android:exported="false"
        android:grantUriPermissions="true">
        <meta-data
          android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/file_paths" />
      </provider>

      <!-- What this app hands its siblings of the suite (server, token, appearance), to them alone. -->
      <provider
        android:name="com.stephenprn.unlease.suitelink.SuiteProvider"
        android:authorities="${applicationId}.suite"
        android:exported="true"
        android:readPermission="com.stephenprn.unlease.permission.SUITE" />

      <!-- The reminders seen to after the system's changes (mobile/shared/android/src/reminders): each a
           protected broadcast only Android sends, so not exported. -->
      <receiver android:name="com.stephenprn.unlease.reminders.RefreshReceiver" android:exported="false">
        <intent-filter>
          <action android:name="android.intent.action.BOOT_COMPLETED" />
          <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
          <action android:name="android.intent.action.TIME_SET" />
          <action android:name="android.intent.action.TIMEZONE_CHANGED" />
          <action android:name="android.intent.action.LOCALE_CHANGED" />
          <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
        </intent-filter>
      </receiver>

      <service android:name="app.notifee.core.ForegroundService" tools:node="remove" />
      <!-- Notifee declares the activity a notification's tap goes through exported, with no permission:
           any app could start it with extras of its choosing, handed to the app as a press on one of
           its notifications. Only the app's own notifications go through it, by PendingIntents, which
           start a component that is not exported as well. -->
      <activity
        android:name="app.notifee.core.NotificationReceiverActivity"
        android:exported="false"
        tools:replace="android:exported" />
    </application>
</manifest>
