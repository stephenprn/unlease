<?xml version="1.0" encoding="utf-8"?>
<!-- Collection: a piece of the collection's page on its slab. The head is the selector (its emblem on
     its stone, its name, a chevron); "+" adds a link to it without opening the app. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wgen_panel_ground"
    android:foreground="@drawable/wgen_panel_edge">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp">

            <LinearLayout
                android:id="@+id/collection_pick"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_weight="1"
                android:background="@drawable/wgen_row_press"
                android:contentDescription="@string/widget_collection_pick"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="40dp">

                    <ImageView
                        android:id="@+id/collection_stone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/wgen_pebble_0" />

                    <ImageView
                        android:id="@+id/collection_emblem"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/wgen_emblem_bac" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Its name in Signika (WidgetType), the chevron right after it; the text view is its plain twin. -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/collection_title_image"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/collection_chevron"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="2dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/wgen_g_chevron_down_ink_muted"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/collection_title"
                            style="@style/WidgetText.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableEnd="@drawable/wgen_g_chevron_down_ink_muted"
                            android:drawablePadding="2dp"
                            android:ellipsize="end"
                            android:maxLines="1" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/collection_count"
                        style="@style/WidgetText.Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/collection_add"
                style="@style/WidgetIconButton.Head"
                android:background="@drawable/wgen_press_1"
                android:contentDescription="@string/widget_collection_add"
                android:src="@drawable/wgen_g_plus" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/collection_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="true"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:paddingBottom="10dp"
                android:scrollbars="none" />

            <!-- Android 11 and older cannot hand a list its rows: the first ones, still. -->
            <LinearLayout
                android:id="@+id/collection_static"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/collection_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingBottom="12dp"
                android:visibility="gone">

                <TextView
                    style="@style/WidgetText.Meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_collection_empty" />

                <LinearLayout
                    android:id="@+id/collection_empty_add"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/wgen_control_press"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/wgen_g_plus_link" />

                    <TextView
                        style="@style/WidgetText.Action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/widget_collection_add" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
