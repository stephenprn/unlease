<?xml version="1.0" encoding="utf-8"?>
<!-- Listes d'un label: one of a label's notes on its own sheet (paper, or its wash), a task widget. The
     head is the selector (the note's title and a chevron, the label's tag and name under it): a tap
     picks another of the label's notes over the home screen. « + » adds items to a list without
     opening the app, the pen opens the note; its items tick right here, as on a note widget. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:clipToOutline="true"
    android:outlineProvider="bounds"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wgen_panel_paper"
    android:foreground="@drawable/wgen_panel_edge">

    <!-- The paper's grain, between the paper (its wash may tint it) and the words. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/wgen_grain_panel" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp">

            <LinearLayout
                android:id="@+id/lists_pick"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/wgen_row_press"
                android:contentDescription="@string/widget_lists_pick"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp">

                <!-- The note's title in Signika (WidgetType), the chevron right after it; the text view is its plain twin. -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/lists_title_image"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/lists_chevron"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="2dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/wgen_g_chevron_down_ink_muted"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/lists_title"
                        style="@style/WidgetText.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableEnd="@drawable/wgen_g_chevron_down_ink_muted"
                        android:drawablePadding="2dp"
                        android:ellipsize="end"
                        android:maxLines="1" />
                </LinearLayout>

                <!-- The label it lists, its tag in its pigment, and what is left to do (none with no note: the title is the label). -->
                <LinearLayout
                    android:id="@+id/lists_meta_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/lists_tag"
                        android:layout_width="17dp"
                        android:layout_height="12dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/wgen_tag" />

                    <TextView
                        android:id="@+id/lists_meta"
                        style="@style/WidgetText.Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:ellipsize="end"
                        android:maxLines="1" />
                </LinearLayout>
            </LinearLayout>

            <!-- The note in the app; left out where the head is narrow. -->
            <ImageView
                android:id="@+id/lists_open"
                style="@style/WidgetIconButton.Head"
                android:background="@drawable/wgen_press_2"
                android:contentDescription="@string/widget_note_open"
                android:src="@drawable/wgen_g_edit" />

            <!-- A list's « + »: items added over the home screen, the app left closed. -->
            <ImageView
                android:id="@+id/lists_add"
                style="@style/WidgetIconButton.Head"
                android:background="@drawable/wgen_press_1"
                android:contentDescription="@string/widget_note_add"
                android:src="@drawable/wgen_g_plus" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- No selector of the list's own: each row presses inside its shape (widget_note.xml). -->
            <ListView
                android:id="@+id/lists_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="true"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:listSelector="@android:color/transparent"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="10dp"
                android:scrollbars="none" />

            <!-- The list's foot fades into the note's paper (or its wash), where its padding starts. -->
            <FrameLayout
                android:id="@+id/lists_fade"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_gravity="bottom"
                android:layout_marginBottom="10dp"
                android:background="@drawable/wgen_fade_paper" />

            <LinearLayout
                android:id="@+id/lists_static"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:visibility="gone" />

            <!-- Nothing to show: an empty list (its « + » adds), or a label wearing no note yet. -->
            <LinearLayout
                android:id="@+id/lists_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingBottom="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/lists_empty_text"
                    style="@style/WidgetText.Meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />

                <LinearLayout
                    android:id="@+id/lists_empty_add"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/wgen_control_press"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/wgen_g_plus_link" />

                    <TextView
                        android:id="@+id/lists_empty_action"
                        style="@style/WidgetText.Action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
