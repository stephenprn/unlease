<?xml version="1.0" encoding="utf-8"?>
<!-- The list's foot: the whole collection in the app, and what is done already. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="6dp"
    android:paddingTop="2dp"
    android:paddingEnd="6dp">

    <LinearLayout
        android:id="@+id/more_open"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/wgen_row_press"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="14dp">

        <TextView
            style="@style/WidgetText.Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableEnd="@drawable/wgen_g_chevron_right_link"
            android:drawablePadding="2dp"
            android:text="@string/widget_collection_open" />

        <TextView
            android:id="@+id/more_done"
            style="@style/WidgetText.Meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1" />
    </LinearLayout>
</FrameLayout>
