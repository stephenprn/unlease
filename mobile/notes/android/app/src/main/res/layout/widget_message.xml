<?xml version="1.0" encoding="utf-8"?>
<!-- A widget with nothing to draw yet, or whose collection, label or note is gone: the mark, one line,
     and what a tap does. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/message_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wgen_panel_ground"
    android:foreground="@drawable/wgen_panel_edge">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_mark" />

        <TextView
            android:id="@+id/message_text"
            style="@style/WidgetText.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/message_action"
            style="@style/WidgetText.Action"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/wgen_control_press"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
