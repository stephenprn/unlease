<?xml version="1.0" encoding="utf-8"?>
<!-- The picker's preview of a lists widget: sample content. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:clipToOutline="true" android:outlineProvider="bounds" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/wgen_panel_paper" android:foreground="@drawable/wgen_panel_edge">
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/wgen_grain_panel" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:minHeight="62dp" android:orientation="horizontal" android:paddingStart="16dp" android:paddingTop="6dp" android:paddingEnd="6dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/WidgetText.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:drawableEnd="@drawable/wgen_g_chevron_down_ink_muted" android:drawablePadding="2dp" android:ellipsize="end" android:maxLines="1" android:text="@string/widget_preview_list" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="17dp" android:layout_height="12dp" android:scaleType="fitXY" android:src="@drawable/wgen_tag" android:tint="@color/wgen_pigment_green" />
                    <TextView style="@style/WidgetText.Meta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:ellipsize="end" android:maxLines="1" android:text="@string/widget_preview_market_meta" />
                </LinearLayout>
            </LinearLayout>
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="13dp" android:scaleType="fitCenter" android:src="@drawable/wgen_g_plus" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:gravity="center_vertical" android:minHeight="48dp" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="10dp">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:scaleType="center" android:src="@drawable/wgen_check_open" />
            <TextView style="@style/WidgetText.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="@string/widget_preview_tomatoes" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:gravity="center_vertical" android:minHeight="48dp" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="10dp">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:scaleType="center" android:src="@drawable/wgen_check_open" />
            <TextView style="@style/WidgetText.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="@string/widget_preview_basil" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:gravity="center_vertical" android:minHeight="48dp" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="10dp">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:scaleType="center" android:src="@drawable/wgen_check_open" />
            <TextView style="@style/WidgetText.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="@string/widget_preview_bread" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
