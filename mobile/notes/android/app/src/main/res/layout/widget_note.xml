<?xml version="1.0" encoding="utf-8"?>
<!-- Note: the note's own sheet (paper, or its wash). Its title opens it in the app; a checklist's items
     tick right here, the done ones gathered at the foot as in the editor, and « + » adds one over the
     home screen. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:clipToOutline="true"
    android:outlineProvider="bounds"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wgen_panel_paper"
    android:foreground="@drawable/wgen_panel_edge">

    <!-- The paper's grain, between the paper (its wash may tint it) and the words. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/wgen_grain_panel" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp">

        <LinearLayout
            android:id="@+id/note_open"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/wgen_row_press"
            android:contentDescription="@string/widget_note_open"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <!-- Its title in Signika (WidgetType); the text view is its plain twin. -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/note_title_image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/note_title"
                    style="@style/WidgetText.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2" />

                <!-- Its emoji in their own colours, over the words' mask (WidgetEmoji). -->
                <ImageView
                    android:id="@+id/note_title_emoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- The pen, as a lists widget's: the same glyph (22) in the same slot beside « + »; the whole head opens the note. -->
            <ImageView
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:importantForAccessibility="no"
                android:paddingStart="13dp"
                android:paddingTop="7dp"
                android:paddingEnd="13dp"
                android:paddingBottom="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/wgen_g_edit" />
        </LinearLayout>

        <!-- A checklist's « + »: items added over the home screen, the app left closed. -->
        <ImageView
            android:id="@+id/note_add"
            style="@style/WidgetIconButton.Head"
            android:background="@drawable/wgen_press_1"
            android:contentDescription="@string/widget_note_add"
            android:src="@drawable/wgen_g_plus"
            android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- No selector of the list's own: each row presses inside its shape, and a list's selector,
                 a square under the row, lingered where a ticked item had moved from. -->
            <ListView
                android:id="@+id/note_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="true"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:listSelector="@android:color/transparent"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="6dp"
                android:scrollbars="none" />

            <!-- The list's foot fades into the note's paper (or its wash) at the sheet's edge, cut to its corners: the list stops 6 above the edge, where the fade is whole and the corner's curve has come in less than anything it holds, so a row cut there reads as more below; its last row, a clear foot (widget_list_foot), keeps the last one clear of the fade once scrolled to the end. -->
            <FrameLayout
                android:id="@+id/note_fade"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_gravity="bottom"
                android:background="@drawable/wgen_fade_paper" />

            <LinearLayout
                android:id="@+id/note_static"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/note_empty"
                style="@style/WidgetText.Meta"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingBottom="12dp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
