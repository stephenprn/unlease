<?xml version="1.0" encoding="utf-8"?>
<!-- Actions rapides: no data, no update period; a row, or two rows with the search strip. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="50dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="50dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_quick"
    android:previewLayout="@layout/widget_quick"
    android:description="@string/widget_capture_description"
    android:widgetCategory="home_screen" />
