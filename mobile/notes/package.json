{
  "name": "@unlease/notes-mobile",
  "version": "0.1.0",
  "description": "Carnet for Android: the notes app of Unlease, in React Native.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stephenprn/unlease.git",
    "directory": "mobile/notes"
  },
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "start": "react-native start",
    "lint": "eslint src specs __mocks__ jest.setup.js App.tsx",
    "test": "jest src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "npm run typecheck && npm run lint -- --quiet && npm run test -- --silent",
    "fonts": "python3 ../../tools/fonts/build_fonts.py"
  },
  "codegenConfig": {
    "name": "CarnetSpec",
    "type": "all",
    "jsSrcsDir": "./specs",
    "android": {
      "javaPackageName": "com.stephenprn.carnet.specs"
    }
  },
  "dependencies": {
    "@notifee/react-native": "^9.1.8",
    "@op-engineering/op-sqlite": "^18.2.5",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "^3.4.0",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-screens": "^4.30.0",
    "react-native-svg": "^15.16.0",
    "react-native-worklets": "^0.13.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/runtime": "^7.29.10",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "prettier": "^3.9.10",
    "react-native-asset": "^2.3.0",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
