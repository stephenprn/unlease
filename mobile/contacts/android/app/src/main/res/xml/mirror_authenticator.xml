<?xml version="1.0" encoding="utf-8"?>
<!-- The mirror account's authenticator (mobile/shared/android/src/mirror, MirrorAccount): its type is
     `<applicationId>.mirror`, written by dev-builds.gradle, so a dev build's account is another one. -->
