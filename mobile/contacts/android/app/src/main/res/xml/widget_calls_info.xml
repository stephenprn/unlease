<?xml version="1.0" encoding="utf-8"?>
<!-- Its list (the favourites or a label) is chosen as it is placed, and again from the launcher (reconfigurable): the quick window's picker. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:configure="com.stephenprn.contacts.widget.QuickActivity"
    android:widgetFeatures="reconfigurable"
    android:initialLayout="@layout/widget_message"
    android:previewLayout="@layout/widget_calls_preview"
    android:description="@string/widget_calls_description"
    android:widgetCategory="home_screen" />
