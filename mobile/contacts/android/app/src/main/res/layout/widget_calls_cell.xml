<?xml version="1.0" encoding="utf-8"?>
<!-- A face of « Appels rapides »: the photo cut to the frame's corner, or the initials on the contact's
     pigment in the same frame (the app's ContactAvatar), and the first name under it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cell"
    android:layout_width="76dp"
    android:layout_height="88dp"
    android:background="@drawable/wgen_row_press"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="8dp">

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp">

        <ImageView
            android:id="@+id/face_tile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/wgen_face" />

        <ImageView
            android:id="@+id/face_initials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/face_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/face_name"
        style="@style/WidgetText.LabelSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp" />
</LinearLayout>
