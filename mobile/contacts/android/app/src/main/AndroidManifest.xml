<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Sync and the photos the server fetches need the owner's server, so the release build keeps INTERNET. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To hear the network come back, so sync resumes at once. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- « Importer les contacts du téléphone » (Google's synced ones included) and WhatsApp's call rows
         for a number: asked at runtime, only when the person chooses one of them. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- « Appeler » and the quick calls place the call at once (ACTION_CALL), as Google's direct dial
         does; asked at the first call, and without it the dialer opens with the number (ACTION_DIAL). -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Birthday notifications (Notifee), asked when they are turned on; RECEIVE_BOOT_COMPLETED lets
         Notifee arm them again after a restart, and the reminders' refresh run (RefreshReceiver). They
         come at the hour chosen: exact alarms (an inexact one may come up to an hour late). From
         Android 13, USE_EXACT_ALARM, granted at install and never taken back; Android 12 asks for
         SCHEDULE_EXACT_ALARM. Sideloaded, never on Play, so the store's exact-alarm policy does not apply. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" tools:node="replace" />
    <!-- Réglages' « Notifications à l'heure » asks Android to leave the app out of the battery's
         optimization only when the person chooses to (RemindersModule). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Declared by Notifee for features this app never uses. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" tools:node="remove" />
    <uses-permission android:name="android.permission.BROADCAST_CLOSE_SYSTEM_DIALOGS" tools:node="remove" />
    <!-- No telephony needed to install (a tablet keeps its contacts too): calls then open nothing. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- The suite's link between its apps on one phone (mobile/shared, SuiteLink): only an app signed
         by the same key holds this permission, so only the suite's own apps read each other's
         connection (the token is a secret). Every app of the suite declares it the same way. -->
    <permission
        android:name="com.stephenprn.unlease.permission.SUITE"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.stephenprn.unlease.permission.SUITE" />

    <!-- Picker and camera are reached by intent: no storage or camera permission is held. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <!-- The phone's maps apps (MapApps): an address opens in the one chosen, or they are offered. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <!-- The suite's apps, seen from this one: their providers (SuiteLink) and their links
             (carnet://note/<id>, unlease-pages://page/<id>). and Agenda's
             (unlease-agenda://event/<id>). -->
        <package android:name="com.stephenprn.carnet" />
        <package android:name="com.stephenprn.pages" />
        <package android:name="com.stephenprn.contacts" />
        <package android:name="com.stephenprn.agenda" />
        <!-- WhatsApp's actions show while it is installed (its business edition too). -->
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:fullBackupContent="@xml/backup_rules"
      android:dataExtractionRules="@xml/data_extraction_rules"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|locale|layoutDirection"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <!-- Opened from the launcher through its entries below (one per palette's icon), never directly:
             every other way in stays here. -->

        <!-- A contact card shared to the app (WhatsApp's « Partager le contact », a file manager's
             .vcf): it opens the import, the card already read (IntakeModule). -->
        <intent-filter android:label="@string/import_contacts">
            <action android:name="android.intent.action.SEND" />
            <action android:name="android.intent.action.SEND_MULTIPLE" />
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="text/x-vcard" />
            <data android:mimeType="text/vcard" />
            <data android:mimeType="text/directory" />
        </intent-filter>

        <!-- « Créer un contact » from another app (the dialer's, Messages', a mail app's), and « Ajouter à un
             contact » (INSERT_OR_EDIT): the new contact's form, filled with what it hands
             (ContactsContract.Intents.Insert, IntakeModule); nothing is kept until it is saved. -->
        <intent-filter android:label="@string/add_contact">
            <action android:name="android.intent.action.INSERT" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="vnd.android.cursor.dir/contact" />
            <data android:mimeType="vnd.android.cursor.dir/raw_contact" />
            <data android:mimeType="vnd.android.cursor.dir/person" />
        </intent-filter>
        <intent-filter android:label="@string/add_contact">
            <action android:name="android.intent.action.INSERT_OR_EDIT" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="vnd.android.cursor.item/contact" />
            <data android:mimeType="vnd.android.cursor.item/raw_contact" />
            <data android:mimeType="vnd.android.cursor.item/person" />
        </intent-filter>

        <!-- unlease-contacts://contact/<id>, new, favorites, birthdays, label/<id> (APPS.contacts.scheme), its home with no path: custom scheme, no host. -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="unlease-contacts" />
        </intent-filter>
      </activity>

      <!-- The launcher's entries: the app's icon in each palette's primary (tools/icons/build_android_drawables.mjs),
           the one for the person's primary turned on when the app leaves the screen
           (mobile/shared/src/app/launcherIcon.ts). -->
      <!-- GENERATED by tools/icons/build_android_drawables.mjs, do not edit: the launcher entries -->
      <activity-alias
        android:name=".LauncherCarnet"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enabled="true"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.stephenprn.unlease.launcher.palette" android:value="carnet" />
        <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
      </activity-alias>
      <activity-alias
        android:name=".LauncherSarcelle"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_sarcelle"
        android:roundIcon="@mipmap/ic_launcher_sarcelle"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.stephenprn.unlease.launcher.palette" android:value="sarcelle" />
        <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
      </activity-alias>
      <activity-alias
        android:name=".LauncherMyrtille"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_myrtille"
        android:roundIcon="@mipmap/ic_launcher_myrtille"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.stephenprn.unlease.launcher.palette" android:value="myrtille" />
        <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
      </activity-alias>
      <activity-alias
        android:name=".LauncherGlycine"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_glycine"
        android:roundIcon="@mipmap/ic_launcher_glycine"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.stephenprn.unlease.launcher.palette" android:value="glycine" />
        <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
      </activity-alias>
      <activity-alias
        android:name=".LauncherPivoine"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_pivoine"
        android:roundIcon="@mipmap/ic_launcher_pivoine"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.stephenprn.unlease.launcher.palette" android:value="pivoine" />
        <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
      </activity-alias>
      <activity-alias
        android:name=".LauncherMimosa"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_mimosa"
        android:roundIcon="@mipmap/ic_launcher_mimosa"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.stephenprn.unlease.launcher.palette" android:value="mimosa" />
        <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
      </activity-alias>
      <activity-alias
        android:name=".LauncherArdoise"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_ardoise"
        android:roundIcon="@mipmap/ic_launcher_ardoise"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.stephenprn.unlease.launcher.palette" android:value="ardoise" />
        <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
      </activity-alias>
      <activity-alias
        android:name=".LauncherMousse"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_mousse"
        android:roundIcon="@mipmap/ic_launcher_mousse"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.stephenprn.unlease.launcher.palette" android:value="mousse" />
        <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
      </activity-alias>
      <!-- GENERATED: end of the launcher entries -->

      <!-- Where the launcher's static shortcuts land (res/xml/shortcuts.xml): it hands their link to
           MainActivity, so Android's clearing of the task a static shortcut opens touches only its own.
           Never shows. -->
      <activity
        android:name="com.stephenprn.unlease.launch.ShortcutActivity"
        android:theme="@android:style/Theme.NoDisplay"
        android:exported="false"
        android:taskAffinity=""
        android:excludeFromRecents="true"
        android:noHistory="true" />

      <!-- The home-screen widgets (android/.../widget, docs/ARCHITECTURE.md). The providers are exported
           because the launcher broadcasts APPWIDGET_UPDATE to them; they take no data from it. -->

      <receiver
        android:name=".widget.CallsWidgetProvider"
        android:exported="true"
        android:label="@string/widget_calls_label">
        <intent-filter>
          <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent-filter>
        <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/widget_calls_info" />
      </receiver>

      <receiver
        android:name=".widget.AddWidgetProvider"
        android:exported="true"
        android:label="@string/widget_add_label">
        <intent-filter>
          <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent-filter>
        <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/widget_add_info" />
      </receiver>

      <!-- The quick window over the home screen: « Appels rapides » pointed at its list. Exported for the
           launcher's configuration step; its own task, gone once left, never in Recents. -->
      <activity
        android:name=".widget.QuickActivity"
        android:theme="@style/QuickTheme"
        android:exported="true"
        android:label="@string/app_name"
        android:taskAffinity="${applicationId}.quick"
        android:excludeFromRecents="true"
        android:noHistory="true"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|locale|layoutDirection"
        android:windowSoftInputMode="adjustResize">
        <intent-filter>
          <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
        </intent-filter>
      </activity>

      <!-- Sends a widget grid's tap on: a call (Calls.place) or a contact in the app, for a face the widget
           shows only, its number looked up by the app; it never shows. Not exported: only the widget's
           own PendingIntents start it. -->
      <activity
        android:name=".widget.WidgetRouterActivity"
        android:theme="@android:style/Theme.NoDisplay"
        android:exported="false"
        android:taskAffinity=""
        android:excludeFromRecents="true"
        android:noHistory="true" />

      <!-- Lets the system camera app write one photo into files/photos, and a shared card (.vcf)
           leave from cache/shared; not exported. -->
      <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.files"
        android:exported="false"
        android:grantUriPermissions="true">
        <meta-data
          android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/contacts_file_paths" />
      </provider>

      <!-- What this app hands its siblings of the suite (server, token, appearance), to them alone. -->
      <provider
        android:name="com.stephenprn.unlease.suitelink.SuiteProvider"
        android:authorities="${applicationId}.suite"
        android:exported="true"
        android:readPermission="com.stephenprn.unlease.permission.SUITE" />

      <!-- The reminders seen to after the system's changes (mobile/shared/android/src/reminders): each a
           protected broadcast only Android sends, so not exported. -->
      <receiver android:name="com.stephenprn.unlease.reminders.RefreshReceiver" android:exported="false">
        <intent-filter>
          <action android:name="android.intent.action.BOOT_COMPLETED" />
          <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
          <action android:name="android.intent.action.TIME_SET" />
          <action android:name="android.intent.action.TIMEZONE_CHANGED" />
          <action android:name="android.intent.action.LOCALE_CHANGED" />
          <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
        </intent-filter>
      </receiver>

      <service android:name="app.notifee.core.ForegroundService" tools:node="remove" />
      <!-- Notifee declares the activity a notification's tap goes through exported, with no permission:
           any app could start it with extras of its choosing, handed to the app as a press on one of
           its notifications. Only the app's own notifications go through it, by PendingIntents, which
           start a component that is not exported as well. -->
      <activity
        android:name="app.notifee.core.NotificationReceiverActivity"
        android:exported="false"
        tools:replace="android:exported" />
    </application>
</manifest>
