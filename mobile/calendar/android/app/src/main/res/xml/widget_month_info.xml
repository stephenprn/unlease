<?xml version="1.0" encoding="utf-8"?>
<!-- Drawn from what JavaScript hands over; updated every half hour so it starts from today (the picture holds a few days more). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="250dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="3" android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_message"
    android:previewLayout="@layout/widget_month"
    android:description="@string/widget_month_description"
    android:widgetCategory="home_screen" />
