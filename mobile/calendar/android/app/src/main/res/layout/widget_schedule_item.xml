<?xml version="1.0" encoding="utf-8"?>
<!-- One thing of a day in « Planning »: its colour as a stripe, its title, its time and place. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="52dp"
    android:background="@drawable/wgen_row_press"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/item_stripe"
        android:layout_width="5dp"
        android:layout_height="36dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/wgen_stripe" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_title"
            style="@style/WidgetText.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="1" />

        <TextView
            android:id="@+id/item_time"
            style="@style/WidgetText.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
