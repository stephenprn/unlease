<?xml version="1.0" encoding="utf-8"?>
<!-- Aujourd'hui, two cells: a slab of the ground. The day in small, then what runs or comes next:
     its colour as a stripe, its time (« En cours » in the accent's ink while it runs), its title in
     Signika, its place or how many more today. With nothing left, tomorrow's first thing. A tap
     opens it; with nothing, « Aujourd'hui » in the app. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:clipToOutline="true"
    android:outlineProvider="bounds"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wgen_panel_ground"
    android:foreground="@drawable/wgen_panel_edge">

    <LinearLayout
        android:id="@+id/today_open"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/wgen_row_press"
        android:contentDescription="@string/widget_open_today"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/today_day"
            style="@style/WidgetText.MetaStrong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_preview_day" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/today_stripe"
                android:layout_width="5dp"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/wgen_stripe" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/today_when"
                    style="@style/WidgetText.MetaStrong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_preview_time" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/today_title_image"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/today_title"
                        style="@style/WidgetText.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/widget_preview_event" />
                </FrameLayout>

                <TextView
                    android:id="@+id/today_more"
                    style="@style/WidgetText.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
