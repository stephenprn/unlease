<?xml version="1.0" encoding="utf-8"?>
<!-- The picker's preview of « Planning »: sample days (a launcher fills no list in a preview). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:clipToOutline="true" android:outlineProvider="bounds" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/wgen_panel_ground" android:foreground="@drawable/wgen_panel_edge">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginStart="6dp" android:layout_marginTop="4dp" android:layout_marginEnd="4dp" android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingTop="4dp" android:paddingEnd="8dp" android:paddingBottom="4dp">
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_widget_mark" />
                <TextView style="@style/WidgetText.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:ellipsize="end" android:maxLines="1" android:text="@string/widget_preview_schedule" />
            </LinearLayout>
            <ImageView style="@style/WidgetIconButton.Head" android:src="@drawable/wgen_g_plus" />
        </LinearLayout>
        <TextView style="@style/WidgetText.MetaStrong" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:paddingStart="10dp" android:paddingTop="10dp" android:paddingEnd="10dp" android:paddingBottom="4dp" android:ellipsize="end" android:maxLines="1" android:text="@string/widget_preview_day_today" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:minHeight="52dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingTop="6dp" android:paddingEnd="10dp" android:paddingBottom="6dp">
            <ImageView android:layout_width="5dp" android:layout_height="36dp" android:scaleType="fitXY" android:src="@drawable/wgen_stripe" android:tint="@color/wgen_pigment_blue" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/WidgetText.RowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="@string/widget_preview_event" />
                <TextView style="@style/WidgetText.Meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="@string/widget_preview_time" />
            </LinearLayout>
        </LinearLayout>
        <!-- The now line, between what is over by now and lunch. -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="7.5dp" android:paddingTop="3dp" android:paddingEnd="10dp" android:paddingBottom="3dp">
            <ImageView android:layout_width="10dp" android:layout_height="10dp" android:scaleType="fitXY" android:src="@drawable/wgen_dot" android:tint="@color/wgen_danger" />
            <ImageView android:layout_width="0dp" android:layout_height="2dp" android:layout_weight="1" android:background="@color/wgen_danger" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:minHeight="52dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingTop="6dp" android:paddingEnd="10dp" android:paddingBottom="6dp">
            <ImageView android:layout_width="5dp" android:layout_height="36dp" android:scaleType="fitXY" android:src="@drawable/wgen_stripe" android:tint="@color/wgen_pigment_ochre" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/WidgetText.RowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="@string/widget_preview_lunch" />
                <TextView style="@style/WidgetText.Meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="@string/widget_preview_lunch_time" />
            </LinearLayout>
        </LinearLayout>
        <TextView style="@style/WidgetText.MetaStrong" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:paddingStart="10dp" android:paddingTop="10dp" android:paddingEnd="10dp" android:paddingBottom="4dp" android:ellipsize="end" android:maxLines="1" android:text="@string/widget_preview_day_tomorrow" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:minHeight="52dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingTop="6dp" android:paddingEnd="10dp" android:paddingBottom="6dp">
            <ImageView android:layout_width="5dp" android:layout_height="36dp" android:scaleType="fitXY" android:src="@drawable/wgen_stripe" android:tint="@color/wgen_pigment_sky" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/WidgetText.RowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="@string/widget_preview_train" />
                <TextView style="@style/WidgetText.Meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="@string/widget_preview_train_time" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
