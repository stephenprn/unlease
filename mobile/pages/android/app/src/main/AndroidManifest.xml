<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sync and questions to Claude need the owner's server, so the release build keeps INTERNET. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To hear the network come back, so sync resumes at once. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The suite's link between its apps on one phone (mobile/shared, SuiteLink): only an app signed
         by the same key holds this permission, so only the suite's own apps read each other's
         connection (the token is a secret). Every app of the suite declares it the same way;
         a dev build (debug, devRelease) its `.dev` one, and names the `.dev` siblings below, so it never
         reads a released app (mobile/shared/android/dev-builds.gradle). -->
    <permission
        android:name="com.stephenprn.unlease${suiteSuffix}.permission.SUITE"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.stephenprn.unlease${suiteSuffix}.permission.SUITE" />

    <!-- Picker and camera are reached by intent: no storage or camera permission is held. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <!-- The suite's apps, seen from this one: their providers (SuiteLink) and their links
             (carnet://note/<id>). and Agenda's
             (unlease-agenda://event/<id>). -->
        <package android:name="com.stephenprn.carnet${suiteSuffix}" />
        <package android:name="com.stephenprn.pages${suiteSuffix}" />
        <package android:name="com.stephenprn.contacts${suiteSuffix}" />
        <package android:name="com.stephenprn.agenda${suiteSuffix}" />
    </queries>

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:fullBackupContent="@xml/backup_rules"
      android:dataExtractionRules="@xml/data_extraction_rules"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <!-- Opened from the launcher through its entries below (one per palette's icon), never directly:
             every other way in stays here. -->

        <!-- The share sheet: text or a link becomes a new page (src/app/intake.ts). -->
        <intent-filter android:label="@string/share_page">
            <action android:name="android.intent.action.SEND" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="text/plain" />
        </intent-filter>

        <!-- unlease-pages://page/<id> (APPS.pages.scheme), its home with no path: custom scheme, no host. -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="${appScheme}" />
        </intent-filter>
      </activity>

      <!-- The launcher's entries: the app's icon in each palette's primary (tools/icons/build_android_drawables.mjs),
           the one for the person's primary turned on when the app leaves the screen
           (mobile/shared/src/app/launcherIcon.ts). -->
      <!-- GENERATED by tools/icons/build_android_drawables.mjs, do not edit: the launcher entries -->
      <activity-alias
        android:name=".LauncherCarnet"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enabled="true"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.stephenprn.unlease.launcher.palette" android:value="carnet" />
        <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
      </activity-alias>
      <activity-alias
        android:name=".LauncherSarcelle"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_sarcelle"
        android:roundIcon="@mipmap/ic_launcher_sarcelle"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.stephenprn.unlease.launcher.palette" android:value="sarcelle" />
        <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
      </activity-alias>
      <activity-alias
        android:name=".LauncherMyrtille"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_myrtille"
        android:roundIcon="@mipmap/ic_launcher_myrtille"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.stephenprn.unlease.launcher.palette" android:value="myrtille" />
        <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
      </activity-alias>
      <activity-alias
        android:name=".LauncherGlycine"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_glycine"
        android:roundIcon="@mipmap/ic_launcher_glycine"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.stephenprn.unlease.launcher.palette" android:value="glycine" />
        <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
      </activity-alias>
      <activity-alias
        android:name=".LauncherPivoine"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_pivoine"
        android:roundIcon="@mipmap/ic_launcher_pivoine"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.stephenprn.unlease.launcher.palette" android:value="pivoine" />
        <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
      </activity-alias>
      <activity-alias
        android:name=".LauncherMimosa"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_mimosa"
        android:roundIcon="@mipmap/ic_launcher_mimosa"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.stephenprn.unlease.launcher.palette" android:value="mimosa" />
        <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
      </activity-alias>
      <activity-alias
        android:name=".LauncherArdoise"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_ardoise"
        android:roundIcon="@mipmap/ic_launcher_ardoise"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.stephenprn.unlease.launcher.palette" android:value="ardoise" />
        <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
      </activity-alias>
      <activity-alias
        android:name=".LauncherMousse"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_mousse"
        android:roundIcon="@mipmap/ic_launcher_mousse"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.stephenprn.unlease.launcher.palette" android:value="mousse" />
        <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
      </activity-alias>
      <!-- GENERATED: end of the launcher entries -->

      <!-- Where the launcher's static shortcuts land (res/xml/shortcuts.xml): it hands their link to
           MainActivity, so Android's clearing of the task a static shortcut opens touches only its own.
           Never shows. -->
      <activity
        android:name="com.stephenprn.unlease.launch.ShortcutActivity"
        android:theme="@android:style/Theme.NoDisplay"
        android:exported="false"
        android:taskAffinity=""
        android:excludeFromRecents="true"
        android:noHistory="true" />

      <!-- Lets the system camera app write one photo into files/photos; not exported. -->
      <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.files"
        android:exported="false"
        android:grantUriPermissions="true">
        <meta-data
          android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/file_paths" />
      </provider>

      <!-- What this app hands its siblings of the suite (server, token, appearance), to them alone. -->
      <provider
        android:name="com.stephenprn.unlease.suitelink.SuiteProvider"
        android:authorities="${applicationId}.suite"
        android:exported="true"
        android:readPermission="com.stephenprn.unlease${suiteSuffix}.permission.SUITE" />
    </application>
</manifest>
