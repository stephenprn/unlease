<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Sync and the weather the server reads need the owner's server, so the release build keeps INTERNET. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To hear the network come back, so sync resumes at once. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The alarms (alarm/, docs/ARCHITECTURE.md « Clock »). Each next ring is armed with setAlarmClock,
         exact to the minute and never held back: from Android 13 USE_EXACT_ALARM, granted at install
         and never taken back (an alarm clock is what it is for); Android 12 asks for SCHEDULE_EXACT_ALARM.
         Sideloaded, never on Play, so the store's policy on these does not apply. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" tools:node="replace" />
    <!-- Armed again after a restart (before the first unlock too) and an update: Android forgets alarms then. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- An alarm rings in a foreground service (RingService): Android 14's `systemExempted` type, which an
         app holding exact alarms may use for its alarms; `mediaPlayback` on Android 10 to 13. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- The ringing window over the lock screen, turning the screen on (Android 14 keeps it to calling
         and alarm apps: granted at install to this one; Réglages says so if it was taken back). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- The ringing notification, the evening check, a snoozed or missed alarm (asked at the first alarm). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The phone kept awake while it rings, and between the alarm and the service's start. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Réglages' « Notifications à l'heure » asks Android to leave the app out of the battery's
         optimization only when the person chooses to (RemindersModule). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- The weather as an alarm rings, where the phone is (coarse: a town is enough); asked when
         Réglages' « Météo pour » is « Ici », read only from the place the phone last knew, never tracked. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Declared by Notifee for features this app never uses. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" tools:node="remove" />
    <uses-permission android:name="android.permission.BROADCAST_CLOSE_SYSTEM_DIALOGS" tools:node="remove" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!-- The suite's link between its apps on one phone (mobile/shared, SuiteLink): only an app signed
         by the same key holds this permission, so only the suite's own apps read each other's
         connection (the token is a secret). Every app of the suite declares it the same way;
         a dev build (debug, devRelease) its `.dev` one, and names the `.dev` siblings below, so it never
         reads a released app (mobile/shared/android/dev-builds.gradle). -->
    <permission
        android:name="com.stephenprn.unlease${suiteSuffix}.permission.SUITE"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.stephenprn.unlease${suiteSuffix}.permission.SUITE" />

    <queries>
        <!-- The suite's apps, seen from this one: their providers (SuiteLink) and their links
             (« Voir la journée »: unlease-agenda://day/<day>). -->
        <package android:name="com.stephenprn.carnet${suiteSuffix}" />
        <package android:name="com.stephenprn.pages${suiteSuffix}" />
        <package android:name="com.stephenprn.contacts${suiteSuffix}" />
        <package android:name="com.stephenprn.agenda${suiteSuffix}" />
        <package android:name="com.stephenprn.clock${suiteSuffix}" />
        <package android:name="com.stephenprn.wallet${suiteSuffix}" />
    </queries>

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:fullBackupContent="@xml/backup_rules"
      android:dataExtractionRules="@xml/data_extraction_rules"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|locale|layoutDirection"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <!-- Opened from the launcher through its entries below (one per palette's icon), never directly:
             every other way in stays here. -->

        <!-- Another app's « set an alarm » (the assistant, a calendar, a timer: AlarmClock.ACTION_SET_ALARM):
             the new alarm's form, filled with what it hands (IntakeModule); nothing is kept until it is
             saved. « Show alarms » opens the list. -->
        <intent-filter android:label="@string/set_alarm">
          <action android:name="android.intent.action.SET_ALARM" />
          <category android:name="android.intent.category.DEFAULT" />
        </intent-filter>
        <intent-filter>
          <action android:name="android.intent.action.SHOW_ALARMS" />
          <category android:name="android.intent.category.DEFAULT" />
        </intent-filter>

        <!-- unlease-clock://alarm/<id>, new, settings (APPS.clock.scheme), its home with no path: custom scheme, no host. -->
        <intent-filter>
          <action android:name="android.intent.action.VIEW" />
          <category android:name="android.intent.category.DEFAULT" />
          <category android:name="android.intent.category.BROWSABLE" />
          <data android:scheme="${appScheme}" />
        </intent-filter>
      </activity>

      <!-- The launcher's entries: the app's icon in each palette's primary (tools/icons/build_android_drawables.mjs),
           the one for the person's primary turned on when the app leaves the screen
           (mobile/shared/src/app/launcherIcon.ts). -->
      <!-- GENERATED by tools/icons/build_android_drawables.mjs, do not edit: the launcher entries -->
      <activity-alias
        android:name=".LauncherCarnet"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enabled="true"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.stephenprn.unlease.launcher.palette" android:value="carnet" />
        <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
      </activity-alias>
      <activity-alias
        android:name=".LauncherSarcelle"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_sarcelle"
        android:roundIcon="@mipmap/ic_launcher_sarcelle"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.stephenprn.unlease.launcher.palette" android:value="sarcelle" />
        <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
      </activity-alias>
      <activity-alias
        android:name=".LauncherMyrtille"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_myrtille"
        android:roundIcon="@mipmap/ic_launcher_myrtille"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.stephenprn.unlease.launcher.palette" android:value="myrtille" />
        <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
      </activity-alias>
      <activity-alias
        android:name=".LauncherGlycine"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_glycine"
        android:roundIcon="@mipmap/ic_launcher_glycine"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.stephenprn.unlease.launcher.palette" android:value="glycine" />
        <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
      </activity-alias>
      <activity-alias
        android:name=".LauncherPivoine"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_pivoine"
        android:roundIcon="@mipmap/ic_launcher_pivoine"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.stephenprn.unlease.launcher.palette" android:value="pivoine" />
        <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
      </activity-alias>
      <activity-alias
        android:name=".LauncherMimosa"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_mimosa"
        android:roundIcon="@mipmap/ic_launcher_mimosa"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.stephenprn.unlease.launcher.palette" android:value="mimosa" />
        <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
      </activity-alias>
      <activity-alias
        android:name=".LauncherArdoise"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_ardoise"
        android:roundIcon="@mipmap/ic_launcher_ardoise"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.stephenprn.unlease.launcher.palette" android:value="ardoise" />
        <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
      </activity-alias>
      <activity-alias
        android:name=".LauncherMousse"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_mousse"
        android:roundIcon="@mipmap/ic_launcher_mousse"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <meta-data android:name="com.stephenprn.unlease.launcher.palette" android:value="mousse" />
        <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
      </activity-alias>
      <!-- GENERATED: end of the launcher entries -->

      <!-- Where the launcher's static shortcuts land (res/xml/shortcuts.xml): it hands their link to
           MainActivity, so Android's clearing of the task a static shortcut opens touches only its own.
           Never shows. -->
      <activity
        android:name="com.stephenprn.unlease.launch.ShortcutActivity"
        android:theme="@android:style/Theme.NoDisplay"
        android:exported="false"
        android:taskAffinity=""
        android:excludeFromRecents="true"
        android:noHistory="true" />

      <!-- The ringing window (alarm/RingActivity, JavaScript's `ringWindow`): over the lock screen, the
           screen turned on, its own task, never in Recents. Only the ringing notification's own
           PendingIntent opens it. -->
      <activity
        android:name=".alarm.RingActivity"
        android:theme="@style/RingTheme"
        android:exported="false"
        android:launchMode="singleInstance"
        android:taskAffinity="${applicationId}.ring"
        android:excludeFromRecents="true"
        android:showWhenLocked="true"
        android:turnScreenOn="true"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|locale|layoutDirection" />

      <!-- The ringing window before the first unlock after a restart (alarm/LockedRingActivity), drawn
           natively since React Native waits for the unlock. Direct Boot aware, over the lock screen. -->
      <activity
        android:name=".alarm.LockedRingActivity"
        android:theme="@style/RingTheme"
        android:exported="false"
        android:directBootAware="true"
        android:launchMode="singleInstance"
        android:taskAffinity="${applicationId}.lockedring"
        android:excludeFromRecents="true"
        android:showWhenLocked="true"
        android:turnScreenOn="true"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|locale|layoutDirection" />

      <!-- The assistant's « stop the alarm », « snooze » (AlarmClock.ACTION_DISMISS_ALARM, ACTION_SNOOZE_ALARM):
           answered at once, nothing shown. -->
      <activity
        android:name=".alarm.AlarmActionsActivity"
        android:theme="@android:style/Theme.NoDisplay"
        android:exported="true"
        android:permission="com.android.alarm.permission.SET_ALARM"
        android:taskAffinity=""
        android:excludeFromRecents="true"
        android:noHistory="true">
        <intent-filter>
          <action android:name="android.intent.action.DISMISS_ALARM" />
          <action android:name="android.intent.action.SNOOZE_ALARM" />
          <category android:name="android.intent.category.DEFAULT" />
        </intent-filter>
      </activity>

      <!-- An alarm ringing (alarm/RingService). Direct Boot aware: it rings before the first unlock after
           a restart too. Not exported: started by the app's own alarms and buttons only. -->
      <service
        android:name=".alarm.RingService"
        android:exported="false"
        android:directBootAware="true"
        android:foregroundServiceType="systemExempted|mediaPlayback" />

      <!-- The alarms' rings and a snoozed alarm's « Arrêter » (alarm/AlarmReceiver): the app's own
           PendingIntents only, so not exported. Direct Boot aware. -->
      <receiver
        android:name=".alarm.AlarmReceiver"
        android:exported="false"
        android:directBootAware="true" />

      <!-- What makes Android forget alarms or move their moments (alarm/AlarmSystemReceiver): a restart,
           before the first unlock too, an update, the clock or the zone set, exact alarms allowed again.
           Protected broadcasts only Android sends, so not exported. -->
      <receiver
        android:name=".alarm.AlarmSystemReceiver"
        android:exported="false"
        android:directBootAware="true">
        <intent-filter>
          <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
          <action android:name="android.intent.action.BOOT_COMPLETED" />
          <action android:name="android.intent.action.QUICKBOOT_POWERON" />
          <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
          <action android:name="android.intent.action.TIME_SET" />
          <action android:name="android.intent.action.TIMEZONE_CHANGED" />
          <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
        </intent-filter>
      </receiver>

      <!-- The home-screen widget « Prochaine alarme » (widget/, docs/ARCHITECTURE.md). Exported because the
           launcher broadcasts APPWIDGET_UPDATE to it; it takes no data from it. -->
      <receiver
        android:name=".widget.NextAlarmWidgetProvider"
        android:exported="true"
        android:label="@string/widget_alarm_label">
        <intent-filter>
          <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent-filter>
        <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/widget_alarm_info" />
      </receiver>

      <!-- The timers and the stopwatch (tools/, docs/ARCHITECTURE.md « Clock »). Timers ringing, in a
           foreground service as the alarms ring (Direct Boot aware: a timer rings before the first unlock
           too); the timers' and the stopwatch's buttons and a timer's end, the app's own PendingIntents
           only; a timer's window over the lock screen, opened by its ringing notification. -->
      <service
        android:name=".tools.TimerService"
        android:exported="false"
        android:directBootAware="true"
        android:foregroundServiceType="systemExempted|mediaPlayback" />
      <receiver
        android:name=".tools.ToolReceiver"
        android:exported="false"
        android:directBootAware="true" />
      <activity
        android:name=".tools.TimerRingActivity"
        android:theme="@style/RingTheme"
        android:exported="false"
        android:launchMode="singleInstance"
        android:taskAffinity="${applicationId}.timer"
        android:excludeFromRecents="true"
        android:showWhenLocked="true"
        android:turnScreenOn="true"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|locale|layoutDirection" />

      <!-- The home-screen widgets « Minuteurs », « Chronomètre », « Horloges » and « Horloge » (widget/).
           Exported because the launcher broadcasts APPWIDGET_UPDATE to them; they take no data from it. -->
      <receiver
        android:name=".widget.TimersWidgetProvider"
        android:exported="true"
        android:label="@string/widget_timers_label">
        <intent-filter>
          <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent-filter>
        <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_timers_info" />
      </receiver>
      <receiver
        android:name=".widget.StopwatchWidgetProvider"
        android:exported="true"
        android:label="@string/widget_stopwatch_label">
        <intent-filter>
          <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent-filter>
        <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_stopwatch_info" />
      </receiver>
      <receiver
        android:name=".widget.WorldClocksWidgetProvider"
        android:exported="true"
        android:label="@string/widget_world_label">
        <intent-filter>
          <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent-filter>
        <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_world_info" />
      </receiver>
      <receiver
        android:name=".widget.ClockWidgetProvider"
        android:exported="true"
        android:label="@string/widget_clock_label">
        <intent-filter>
          <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent-filter>
        <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_clock_info" />
      </receiver>

      <!-- What this app hands its siblings of the suite (server, token, appearance), to them alone. -->
      <provider
        android:name="com.stephenprn.unlease.suitelink.SuiteProvider"
        android:authorities="${applicationId}.suite"
        android:exported="true"
        android:readPermission="com.stephenprn.unlease${suiteSuffix}.permission.SUITE" />

      <!-- The evening check and the notice before an alarm seen to after the system's changes
           (mobile/shared/android/src/reminders): each a protected broadcast only Android sends, so not exported. -->
      <receiver android:name="com.stephenprn.unlease.reminders.RefreshReceiver" android:exported="false">
        <intent-filter>
          <action android:name="android.intent.action.BOOT_COMPLETED" />
          <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
          <action android:name="android.intent.action.TIME_SET" />
          <action android:name="android.intent.action.TIMEZONE_CHANGED" />
          <action android:name="android.intent.action.LOCALE_CHANGED" />
          <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
        </intent-filter>
      </receiver>

      <service android:name="app.notifee.core.ForegroundService" tools:node="remove" />
      <!-- Notifee declares the activity a notification's tap goes through exported, with no permission:
           any app could start it with extras of its choosing, handed to the app as a press on one of
           its notifications. Only the app's own notifications go through it, by PendingIntents, which
           start a component that is not exported as well. -->
      <activity
        android:name="app.notifee.core.NotificationReceiverActivity"
        android:exported="false"
        tools:replace="android:exported" />

      <!-- Sync with the app closed (mobile/shared/android, backgroundsync): a network coming up, the
           watch's own intent only this app sends, and a restart or an update, protected broadcasts
           only Android sends, so not exported. -->
      <receiver android:name="com.stephenprn.unlease.backgroundsync.SyncReceiver" android:exported="false">
        <intent-filter>
          <action android:name="android.intent.action.BOOT_COMPLETED" />
          <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        </intent-filter>
      </receiver>
    </application>
</manifest>
