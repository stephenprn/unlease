<?xml version="1.0" encoding="utf-8"?>
<!-- Horloges' preview in the launcher's picker (sample cities); the live one is widget_world.xml. Horloges: a slab of the ground; its head (« Horloges », « + » for a city); a row per city, west to
     east (its name over « Demain · +8 h », the sun or the moon as it is there, its time counting by
     itself: a TextClock set to its zone). Rows are added by WorldClocksWidgetProvider. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:clipToOutline="true"
    android:outlineProvider="bounds"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wgen_panel_ground"
    android:foreground="@drawable/wgen_panel_edge">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="4dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/wgen_row_press"
                android:paddingStart="6dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />

                <TextView
                    style="@style/WidgetText.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_world_label" />
            </FrameLayout>

            <ImageView
                style="@style/WidgetIconButton"
                android:background="@drawable/wgen_press_1"
                android:contentDescription="@string/widget_add_city"
                android:src="@drawable/wgen_g_plus" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/wgen_row_press"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:text="@string/widget_preview_city_one"
                        style="@style/WidgetText.RowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:importantForAccessibility="no"
                        android:maxLines="1" />

                    <TextView
                        android:text="@string/widget_preview_meta_one"
                        style="@style/WidgetText.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:importantForAccessibility="no"
                        android:maxLines="1" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/wgen_g_sun_ink_muted" />

                <TextView
                    android:text="08:15"
                    style="@style/WidgetText.Count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:maxLines="1" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/wgen_row_press"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:text="@string/widget_preview_city_two"
                        style="@style/WidgetText.RowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:importantForAccessibility="no"
                        android:maxLines="1" />

                    <TextView
                        android:text="@string/widget_preview_meta_two"
                        style="@style/WidgetText.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:importantForAccessibility="no"
                        android:maxLines="1" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/wgen_g_moon_ink_muted" />

                <TextView
                    android:text="22:15"
                    style="@style/WidgetText.Count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/WidgetText.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="4dp"
            android:text="@string/widget_no_cities"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
