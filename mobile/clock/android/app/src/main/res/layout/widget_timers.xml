<?xml version="1.0" encoding="utf-8"?>
<!-- Minuteurs: a slab of the ground; its head (« Minuteurs », « + » for a new one); the timers that
     run or ring, each on its card (its name, its countdown counting by itself, « +1 min », pause or
     resume; ringing: « Temps écoulé », the time since, « Arrêter »); then the saved timers, a row each
     that starts it at once (its length, its label, the start glyph); none saved, the usual lengths.
     Rows are added by TimersWidgetProvider, as many as the height holds. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:clipToOutline="true"
    android:outlineProvider="bounds"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wgen_panel_ground"
    android:foreground="@drawable/wgen_panel_edge">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="4dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp">

            <FrameLayout
                android:id="@+id/timers_head"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/wgen_row_press"
                android:paddingStart="6dp">

                <ImageView
                    android:id="@+id/timers_title_image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/timers_title"
                    style="@style/WidgetText.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_timers_label" />
            </FrameLayout>

            <ImageView
                android:id="@+id/timers_add"
                style="@style/WidgetIconButton"
                android:background="@drawable/wgen_press_1"
                android:contentDescription="@string/widget_new_timer"
                android:src="@drawable/wgen_g_plus" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/timers_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>
