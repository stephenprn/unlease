<?xml version="1.0" encoding="utf-8"?>
<!-- A city: its name over « Demain · +8 h », the sun or the moon as it is there, its time counting by itself. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/city_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/wgen_row_press"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/city_name"
            style="@style/WidgetText.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="1" />

        <TextView
            android:id="@+id/city_meta"
            style="@style/WidgetText.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="1" />
    </LinearLayout>

    <ImageView
        android:id="@+id/city_sky"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/wgen_g_sun_ink_muted" />

    <TextClock
        android:id="@+id/city_clock"
        style="@style/WidgetText.Count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:maxLines="1" />
</LinearLayout>
