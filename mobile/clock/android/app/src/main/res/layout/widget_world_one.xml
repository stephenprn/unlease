<?xml version="1.0" encoding="utf-8"?>
<!-- Horloges in one or two cells: the first city alone, its time large (a TextClock set to its zone),
     the sun or the moon before its name, « Demain · +8 h » under it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:clipToOutline="true"
    android:outlineProvider="bounds"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wgen_panel_ground"
    android:foreground="@drawable/wgen_panel_edge">

    <LinearLayout
        android:id="@+id/world_open"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/wgen_row_press"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextClock
            android:id="@+id/one_clock"
            style="@style/WidgetText.Count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textSize="30sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/one_sky"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/wgen_g_sun_ink_muted" />

            <TextView
                android:id="@+id/one_name"
                style="@style/WidgetText.MetaStrong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="@string/widget_world_label"
                android:textColor="@color/wgen_ink" />
        </LinearLayout>

        <TextView
            android:id="@+id/one_meta"
            style="@style/WidgetText.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="1" />
    </LinearLayout>
</FrameLayout>
