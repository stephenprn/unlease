<?xml version="1.0" encoding="utf-8"?>
<!-- Prochaine alarme's preview in the launcher's picker: the tall layout with a sample morning.
     The live one is widget_alarm.xml. Prochaine alarme, two cells and more: a slab of the ground; the day it rings in meta strong and
     « + » at the head's end, the time in Signika (Safran when the morning's first event comes too
     soon), the alarm's name; tall enough, under a hairline, that first event and how far it stands
     from the alarm. A tap opens the alarm. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:clipToOutline="true"
    android:outlineProvider="bounds"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wgen_panel_ground"
    android:foreground="@drawable/wgen_panel_edge">

    <LinearLayout
        android:id="@+id/alarm_open"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/wgen_row_press"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/alarm_day"
            style="@style/WidgetText.MetaStrong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="40dp"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="1"
                android:text="@string/widget_preview_day" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">

            <ImageView
                android:id="@+id/alarm_time_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <TextView
                android:id="@+id/alarm_time"
                style="@style/WidgetText.Time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="@string/widget_preview_time" />
        </FrameLayout>

        <TextView
            android:id="@+id/alarm_name"
            style="@style/WidgetText.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="1"
                android:text="@string/widget_preview_name" />

        <LinearLayout
            android:id="@+id/alarm_morning"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="bottom"
            android:orientation="vertical">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="10dp"
                android:background="@color/wgen_hairline"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/alarm_glyph"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/wgen_g_today_ink_muted" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/alarm_event"
                        style="@style/WidgetText.RowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                android:text="@string/widget_preview_event" />

                    <TextView
                        android:id="@+id/alarm_after"
                        style="@style/WidgetText.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                android:text="@string/widget_preview_after" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/alarm_add"
        style="@style/WidgetIconButton"
        android:layout_gravity="top|end"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/wgen_press_1"
        android:contentDescription="@string/widget_new_alarm"
        android:src="@drawable/wgen_g_plus" />
</FrameLayout>
