<?xml version="1.0" encoding="utf-8"?>
<!-- Minuteurs' preview in the launcher's picker (a sample: a launcher fills no list there); the live one is widget_timers.xml. Minuteurs: a slab of the ground; its head (« Minuteurs », « + » for a new one); the timers that
     run or ring, each on its card (its name, its countdown counting by itself, « +1 min », pause or
     resume; ringing: « Temps écoulé », the time since, « Arrêter »); then the saved timers, a row each
     that starts it at once (its length, its label, the start glyph); none saved, the usual lengths.
     Rows are added by TimersWidgetProvider, as many as the height holds. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:clipToOutline="true"
    android:outlineProvider="bounds"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wgen_panel_ground"
    android:foreground="@drawable/wgen_panel_edge">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="4dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/wgen_row_press"
                android:paddingStart="6dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />

                <TextView
                    style="@style/WidgetText.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_timers_label" />
            </FrameLayout>

            <ImageView
                style="@style/WidgetIconButton"
                android:background="@drawable/wgen_press_1"
                android:contentDescription="@string/widget_new_timer"
                android:src="@drawable/wgen_g_plus" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:background="@drawable/wgen_card_paper"
                android:foreground="@drawable/wgen_card_edge"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="4dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:text="@string/widget_preview_timer_name"
                        style="@style/WidgetText.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1" />

                    <TextView
                        android:text="7:42"
                        style="@style/WidgetText.Count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1" />

                    <TextView
                        style="@style/WidgetText.Count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textColor="@color/wgen_ink_muted"
                        android:visibility="gone" />
                </LinearLayout>

                <ImageView
                    style="@style/WidgetIconButton"
                    android:background="@drawable/wgen_press_2"
                    android:src="@drawable/wgen_g_pause" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/wgen_row_press"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="2dp">

                <TextView
                    android:text="3 min"
                    style="@style/WidgetText.Count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:textSize="20sp" />

                <TextView
                    android:text="@string/widget_preview_timer_one"
                    style="@style/WidgetText.Meta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:importantForAccessibility="no"
                    android:maxLines="1" />

                <ImageView
                    style="@style/WidgetIconButton"
                    android:importantForAccessibility="no"
                    android:src="@drawable/wgen_g_go" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/wgen_row_press"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="2dp">

                <TextView
                    android:text="9 min"
                    style="@style/WidgetText.Count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:textSize="20sp" />

                <TextView
                    android:text="@string/widget_preview_timer_two"
                    style="@style/WidgetText.Meta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:importantForAccessibility="no"
                    android:maxLines="1" />

                <ImageView
                    style="@style/WidgetIconButton"
                    android:importantForAccessibility="no"
                    android:src="@drawable/wgen_g_go" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
