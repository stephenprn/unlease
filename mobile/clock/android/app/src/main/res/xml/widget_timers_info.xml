<?xml version="1.0" encoding="utf-8"?>
<!-- Minuteurs: drawn by TimersWidgetProvider whenever a timer or the saved timers change; its countdowns count by themselves. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="180dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="3" android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_timers"
    android:previewLayout="@layout/widget_timers_preview"
    android:description="@string/widget_timers_description"
    android:widgetCategory="home_screen" />
