<resources>

    <!-- The window ground follows night mode, matching the app's ground until JavaScript draws. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:windowBackground">@color/window_ground</item>
    </style>

    <!-- The ringing window: always the night ground (a dark room at dawn), so the screen that wakes
         the person never flashes white before JavaScript draws it. -->
    <style name="RingTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/ring_ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>

    <!-- The home-screen widget (android/.../widget): the system font for what a launcher draws as text, Signika set by the app (WidgetType.kt). -->
    <style name="WidgetText">
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/wgen_ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineHeight">21sp</item>
    </style>
    <!-- The time's plain twin (and the picker's preview): Signika's 44 at the system font's medium. -->
    <style name="WidgetText.Time">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">44sp</item>
        <item name="android:lineHeight">48sp</item>
        <item name="android:letterSpacing">-0.017</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="WidgetText.RowTitle">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineHeight">20sp</item>
    </style>
    <style name="WidgetText.Meta">
        <item name="android:textColor">@color/wgen_ink_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineHeight">18sp</item>
    </style>
    <style name="WidgetText.MetaStrong" parent="WidgetText.Meta">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <!-- A widget's head title's plain twin (Signika is set as an image by WidgetType.kt). -->
    <style name="WidgetText.Title">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineHeight">22sp</item>
    </style>
    <!-- A timer's, the stopwatch's or a city's time, counting by itself (Chronometer, TextClock): the
         system font, which a launcher can draw, at the medium weight, in tabular figures. -->
    <style name="WidgetText.Count">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">26sp</item>
        <item name="android:lineHeight">30sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <!-- The stopwatch's and the big clock's one figure. -->
    <style name="WidgetText.Big" parent="WidgetText.Count">
        <item name="android:textSize">44sp</item>
        <item name="android:lineHeight">50sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <!-- A text action (« +1 min », « Arrêter »): deep terracotta, in a 48 target, its tint under the press. -->
    <style name="WidgetText.Action">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/wgen_link</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineHeight">18sp</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
    <!-- An icon button in a head: a 22 glyph in a 48 target, its pebble's tint behind it only under the press. -->
    <style name="WidgetIconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">13dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

</resources>
