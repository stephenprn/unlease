<resources>

    <!-- The window ground follows night mode, matching the app's ground until JavaScript draws. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:windowBackground">@color/window_ground</item>
    </style>

    <!-- The ringing window: always the night ground (a dark room at dawn), so the screen that wakes
         the person never flashes white before JavaScript draws it. -->
    <style name="RingTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/ring_ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>

</resources>
