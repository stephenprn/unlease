{
  "name": "@unlease/server",
  "version": "0.1.0",
  "description": "Unlease's server: sync, files, backups and each app's own routes (Carnet's link reading).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stephenprn/unlease.git",
    "directory": "server"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "node build.mjs",
    "start": "node --enable-source-maps --disable-warning=ExperimentalWarning dist/server.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "npm run typecheck && npm run test"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@hono/node-server": "^2.1.5",
    "@types/node": "^24.19.2",
    "domhandler": "^6.0.1",
    "domutils": "^4.0.2",
    "esbuild": "^0.28.2",
    "hono": "^4.13.13",
    "htmlparser2": "^12.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
