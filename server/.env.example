# Required. The bearer token the phone and web apps send. Generate one with: openssl rand -hex 32
UNLEASE_TOKEN=

# Where unlease.sqlite and blobs/ live. Defaults to /data (the image's volume): leave it unset in Docker.
# For `npm run dev` on a laptop, point it somewhere writable:
# UNLEASE_DATA_DIR=./data

PORT=8080

# Origins allowed to call the API from a browser: a web app's dev server, or a web app hosted apart.
# The web app served by this server (UNLEASE_WEB_DIR) and the Android app need none.
UNLEASE_CORS_ORIGINS=http://localhost:5173

# A web app build to serve at / beside the API (the image sets /app/web). Locally, after `npm run build -w web/notes` at the root:
# UNLEASE_WEB_DIR=../web/notes/dist

# low | medium | high | xhigh | max
UNLEASE_CLAUDE_EFFORT=low
UNLEASE_ANALYSIS_CONCURRENCY=2

# The Claude key, model and monthly budget are set from the apps' Administration.
# These are only fallbacks, used while the apps have set nothing:
# ANTHROPIC_API_KEY=
# One of claude-opus-5-5, claude-sonnet-5-5, claude-haiku-5-5:
# UNLEASE_CLAUDE_MODEL=claude-opus-5-5
# UNLEASE_MONTHLY_BUDGET_USD=15
