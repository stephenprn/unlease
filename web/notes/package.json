{
  "name": "@unlease/notes-web",
  "version": "0.1.0",
  "description": "Carnet on the web: the notes app of Unlease, in React and Vite.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stephenprn/unlease.git",
    "directory": "web/notes"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:demo": "vite build --mode demo --outDir dist-demo",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test && vite build",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "highlight.js": "11.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "emojibase-data": "17.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.6",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
