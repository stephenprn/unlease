# Copy to .env next to docker-compose.yml.

# Required. The token every phone and browser sends; generate one with: openssl rand -hex 32
# (64 characters; the server warns at start about one shorter than 32).
UNLEASE_TOKEN=

# The version to run: a release such as 0.2.0. A release's example.env names that release; move it
# when you upgrade, the server before the apps (docs/UPGRADING.md). `latest` follows every release.
UNLEASE_VERSION=latest

# The time zone the drive and the backups' Markdown name photos in (2026-10-26 14.03.12.jpg).
TZ=Europe/Paris

# Only when a web app is hosted apart from this server (a static host): its origins, comma separated.
# The apps served by this server itself need nothing here.
# UNLEASE_CORS_ORIGINS=https://apps.example.org

# Behind a reverse proxy: the header it sets to the client's address, so wrong tokens are braked
# per client rather than per proxy: cf-connecting-ip (Cloudflare Tunnel), x-real-ip (the nginx and
# Caddy examples) or x-forwarded-for (Traefik). Empty: the connection's own address, which nobody can
# forge. Name one only when every request comes through that proxy (docs/SELF-HOSTING.md).
# UNLEASE_TRUSTED_PROXY_HEADER=

# How hard Claude thinks per link: low | medium | high | xhigh | max. Links read at once: 1 to 16.
# UNLEASE_CLAUDE_EFFORT=low
# UNLEASE_ANALYSIS_CONCURRENCY=2

# The places offered as you type an event's place or a contact's address: a Photon server
# (komoot's public one by default, or your own, LAN included), or off.
# UNLEASE_PLACES_URL=https://photon.komoot.io

# Which apps the server runs (Carnet, Pages…), the Claude key, model and monthly budget, S3 and Seafile
# are chosen in the setup, the first time you open the web app, then in Administration.
# These are only fallbacks, used while the apps have set nothing:
# ANTHROPIC_API_KEY=
# UNLEASE_CLAUDE_MODEL=claude-opus-5-5
# UNLEASE_MONTHLY_BUDGET_USD=15
